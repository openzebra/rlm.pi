{"suite":"coding","taskId":"retry_fix","model":"openrouter/qwen/qwen3.8-27b","run":1,"correct":true,"recall":1,"latencyMs":127433,"inputTokens":9753,"outputTokens":7379,"iterations":6,"costUsd":0.026233260000000005,"answer":"\"\"\"HTTP retry helpers — DEFAULT_TIMEOUT_MS is too aggressive (50).\"\"\"\n\nDEFAULT_TIMEOUT_MS = 500\nMAX_RETRIES = 3\n\n\n\ndef with_retry(fn, timeout_ms: int | None = None):\n    timeout = DEFAULT_TIMEOUT_MS if timeout_ms is None else timeout_ms\n    last_err = None\n    for attempt in range(MAX_RETRIES):\n        try:\n            return fn(timeout)\n        except Exception as exc:  # noqa: BLE001\n            last_err = exc\n    raise RuntimeError(f\"failed after {MAX_RETRIES}: {last_err}\")\n","gold":"DEFAULT_TIMEOUT_MS = 500"}
