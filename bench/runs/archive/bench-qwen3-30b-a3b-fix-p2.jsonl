{"suite":"coding","taskId":"retry_fix","model":"openrouter/qwen/qwen3-30b-a3b-instruct-2507","correct":true,"recall":1,"latencyMs":6883,"inputTokens":316,"outputTokens":245,"iterations":2,"costUsd":0,"answer":"\"\"\"HTTP retry helpers — DEFAULT_TIMEOUT_MS is too aggressive (50).\"\"\"\n\nDEFAULT_TIMEOUT_MS = 500\nMAX_RETRIES = 3\n\n\ndef with_retry(fn, timeout_ms: int | None = None):\n    timeout = DEFAULT_TIMEOUT_MS if timeout_ms is None else timeout_ms\n    last_err = None\n    for attempt in range(MAX_RETRIES):\n        try:\n            return fn(timeout)\n        except Exception as exc:  # noqa: BLE001\n            last_err = exc\n    raise RuntimeError(f\"failed after {MAX_RETRIES}: {last_err}\")","gold":"DEFAULT_TIMEOUT_MS = 500"}
